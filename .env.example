# Department of Bad Decisions ($DBD) - example environment file
#
# Copy this file to `.env` and fill in values for your local machine.
# `.env` is git-ignored and MUST NEVER be committed.
#
# SECURITY: This file must NEVER contain a private key, seed phrase,
# mnemonic, or any wallet signing material. This project never needs
# your secret key to run any of its read-only tooling.

# -----------------------------------------------------------------------------
# Solana RPC endpoint (read-only).
# The public mainnet endpoint works for light use. It is rate-limited and not
# suitable for heavy monitoring. Swap in any RPC URL later without code changes.
# -----------------------------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: network the tooling should assume. Must match config network.
# One of: mainnet-beta | devnet | testnet
SOLANA_NETWORK=mainnet-beta

# -----------------------------------------------------------------------------
# Local static server port (npm run serve). Optional.
# -----------------------------------------------------------------------------
PORT=4321
